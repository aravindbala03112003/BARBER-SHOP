# Barber Shop - Environment Configuration Template
# Copy this file to .env and populate with your credentials.

# -------------------------------------------------------------
# APPLICATION SETTINGS
# -------------------------------------------------------------
PORT=3000
NODE_ENV=development
# Comma-separated list of allowed origins for CORS (e.g., https://your-frontend.vercel.app)
# Use * to allow all origins in development
ALLOWED_ORIGINS=*

# -------------------------------------------------------------
# MYSQL DATABASE CONFIGURATION
# -------------------------------------------------------------
# You can provide either a single DATABASE_URL / MYSQL_URL connection string:
# DATABASE_URL=mysql://user:password@host:3306/database_name

# OR individual database connection variables:
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=barber_shop
DB_SSL=false

# -------------------------------------------------------------
# EMAIL NOTIFICATION SETTINGS (SMTP)
# -------------------------------------------------------------
# Example for Gmail:
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=your-salon-email@gmail.com
# EMAIL_PASSWORD=your-google-app-password
#
# Example for Outlook/Office365:
# EMAIL_HOST=smtp.office365.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
#
# Example for Brevo / Sendinblue:
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_SECURE=false

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="Barber Hair Salon" <no-reply@barbershop.com>

# Business administrator email that will receive new booking alerts
BUSINESS_NOTIFICATION_EMAIL=admin@barbershop.com
